# ==============================================================================
# JANSETU — Environment Configuration Template
# Copy to .env for local overrides: cp .env.example .env
# ==============================================================================

# Application Metadata
APP_NAME="JanSetu"
APP_ENV=development

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend URL (Used for Backend CORS policy)
FRONTEND_URL=http://localhost:3000

# Backend Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jansetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Optional direct URI override (postgresql+psycopg://user:password@host:port/dbname)
# DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/jansetu

# Storage & Document Ingestion Configuration
STORAGE_ROOT=./storage
MAX_DOCUMENT_SIZE_MB=100
WATCH_FOLDER_ENABLED=true

# Duplicate & Version Detection Configuration
DUPLICATE_HIGH_SIMILARITY_THRESHOLD=0.98
VERSION_CANDIDATE_THRESHOLD=0.70
TEXT_SIMILARITY_ENABLED=true

# Frontend Public Configuration (Read by Next.js client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
